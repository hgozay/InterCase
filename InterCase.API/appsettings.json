{
  "Jwt": {
    "Issuer": "InterCase",
    "Audience": "InterCase.Client",
    "ExpiryMinutes": 60
  },
  "Cache": {
    "Provider": "Redis",
    // Kullanıcının sipariş listesinin cache'te kaç saniye tutulacağı. Süre dolunca liste DB'den yeniden okunur; yeni sipariş gelince anahtar zaten silinir.
    "OrdersTtlSeconds": 120
  },
  "Queue": {
    "Provider": "RabbitMq"
  },
  "RabbitMq": {
    // Bir consumer'ın onay (ack) vermeden aynı anda üzerinde tutabileceği en fazla mesaj sayısı. Büyürse iş paralelleşir, küçülürse yük worker'lar arasında daha eşit dağılır.
    "PrefetchCount": 10
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/intercase-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
